{
  "name": "qubiq-server-launcher",
  "version": "0.3.0",
  "description": "Crea y gestiona tu servidor de Minecraft en tres clics",
  "main": "./out/main/index.js",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/run-electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "vite build --config scripts/vite.smoke.config.ts && node out/smoke/smoke.mjs",
    "e2e": "vite build --config scripts/vite.e2e.config.ts && node out/e2e/e2e.mjs",
    "e2e:restart": "vite build --config scripts/vite.e2e-restart.config.ts && node out/e2e-restart/e2e-restart.mjs",
    "postinstall": "node -e \"try{require('electron/install.js')}catch(e){}\"",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "author": "AitorMencias"
}
